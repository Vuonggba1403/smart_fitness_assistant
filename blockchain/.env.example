# Private Key của wallet (KHÔNG SHARE FILE NÀY)
# Export từ MetaMask: Settings > Security & Privacy > Show Private Key
PRIVATE_KEY=your_wallet_private_key_here

# RPC URLs (FREE options)
POLYGON_MUMBAI_RPC=https://rpc-mumbai.maticvigil.com
POLYGON_AMOY_RPC=https://rpc-amoy.polygon.technology
POLYGON_RPC=https://polygon-rpc.com
SEPOLIA_RPC=https://rpc.sepolia.org

# API Keys for contract verification (Optional, để verify trên block explorer)
POLYGONSCAN_API_KEY=your_polygonscan_api_key
BSCSCAN_API_KEY=your_bscscan_api_key
ETHERSCAN_API_KEY=your_etherscan_api_key

# IPFS Settings (for NFT metadata)
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_KEY=your_pinata_secret_key
